{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "publicReports": {
      "$token": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "sessions": {
      "$sessionId": {
        ".read": "auth != null",
        "strokes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "cursor": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
